  "description": "Devin Local models in Pi — SWE-2, Opus 5, Fable 5, Sol and friends, with auth and the live model catalog coming from the local Devin CLI.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "devin",
    "devin-local",
    "cognition",
    "swe-2",
    "custom-provider"
  ],
  "license": "MIT",
  "author": "Villoh",
  "contributors": [
    "Kashyab Ambarani (original author, https://github.com/kashyab12/pi-devin)",
    "mizorewww (pi-devin-local fork, https://github.com/mizorewww/pi-devin)"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Villoh/pi-extensions.git",
    "directory": "packages/pi-devin-local"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
